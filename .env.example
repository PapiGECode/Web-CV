# Add these values in Vercel Project > Settings > Environment Variables.
# Never commit credentials. A verified sender domain is required by Resend.
RESEND_API_KEY=
CONTACT_FROM=
# Optional separate secret for hashing temporary rate-limit keys.
CONTACT_RATE_LIMIT_SECRET=
# Optional distributed limit; configure both values together.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
