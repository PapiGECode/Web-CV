{
  "name": "web-cv",
  "account_id": "281f7fbc8ae08e19ea57275b7caa0b45",
  "compatibility_date": "2026-11-17",
  "main": "cloudflare/worker.js",
  "workers_dev": true,
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "pabloschefer.com/*",
      "zone_name": "pabloschefer.com"
    },
    {
      "pattern": "www.pabloschefer.com/*",
      "zone_name": "pabloschefer.com"
    }
  ],
  "vars": {
    "CONTACT_FROM": "Pablo Schefer Web <notificaciones@pabloschefer.com>"
  }
}
