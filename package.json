    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@playwright/test": "1.63.0",
    "@axe-core/playwright": "4.13.0",
    "agent-browser": "0.38.2"
  },
  "dependencies": {
    "web-vitals": "6.2.2"
  }
}
